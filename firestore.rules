rules_version = '2';
// Security rules for Prime Forge online campaigns (GM app and player app).
// Paste this whole file into Firebase console → Firestore Database → Rules, then press Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Everyone signs in with Google or email + password; old guest (anonymous) sessions get nothing.
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    // Each account's name and list of campaigns, so they follow the person to any device.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Room codes: a short code points to one campaign. Anyone signed in can look a code up; nobody can list them.
    match /codes/{code} {
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if signedIn() && request.resource.data.gm == request.auth.uid
                    && get(/databases/$(database)/documents/tables/$(request.resource.data.table)).data.gm == request.auth.uid;
      allow delete: if signedIn() && resource.data.gm == request.auth.uid;
    }

    // A campaign ("table" in the data). Nobody can list them; players reach one through its room code.
    match /tables/{tableId} {
      function table() { return get(/databases/$(database)/documents/tables/$(tableId)).data; }
      function isGM() { return signedIn() && table().gm == request.auth.uid; }
      function isMember() {
        return signedIn() && (exists(/databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid)) || isGM());
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.gm == request.auth.uid;
      allow update: if signedIn() && resource.data.gm == request.auth.uid && request.resource.data.gm == resource.data.gm;
      allow delete: if signedIn() && resource.data.gm == request.auth.uid;

      // People in the campaign. Anyone with the room code can join while the GM leaves joining open.
      match /members/{memberId} {
        allow read: if isMember();
        allow create: if signedIn() && request.auth.uid == memberId && (table().get('open', true) != false || isGM());
        allow update: if signedIn() && request.auth.uid == memberId;
        allow delete: if signedIn() && (request.auth.uid == memberId || isGM());
      }

      // Characters. Players edit their own; the GM edits all, hands them out, and can hide NPCs from players.
      match /chars/{charId} {
        allow read: if isGM() || (isMember() && resource.data.hidden == false);
        allow create: if isMember() && (isGM() || (request.resource.data.owner == request.auth.uid && request.resource.data.hidden == false));
        allow update: if isGM() || (isMember() && resource.data.owner == request.auth.uid
                                     && request.resource.data.owner == request.auth.uid && request.resource.data.hidden == false);
        allow delete: if isGM() || (isMember() && resource.data.owner == request.auth.uid);
      }

      // Rolls the GM asks for (tests, contests, other rolls). Only the GM creates them and rolls opposition.
      // Rounds are a map r0, r1, ... with n = how many. On their turn, the asked player may add exactly
      // one round (r<n>, their own) and nothing else.
      match /checks/{checkId} {
        allow read: if isMember();
        allow create, delete: if isGM();
        allow update: if isGM() || (isMember()
          && resource.data.target == request.auth.uid
          && resource.data.status == 'open' && resource.data.turn == 'player'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rounds', 'n', 'turn', 'status', 'winner', 'margin', 'heroic', 'at'])
          && request.resource.data.n == resource.data.n + 1
          && request.resource.data.rounds.diff(resource.data.rounds).affectedKeys().hasOnly(['r' + string(resource.data.n)])
          && request.resource.data.rounds['r' + string(resource.data.n)].side == 'player');
      }

      // Shared dice rolls.
      match /rolls/{rollId} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.by == request.auth.uid
                      && request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow delete: if isGM();
      }
    }
  }
}
